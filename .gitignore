# Local collaboration records and personal editor state
.agents/
.idea/
.DS_Store
Thumbs.db
xcuserdata/
*.xcuserstate

# Local environment settings; keep shareable examples
.env
.env.*
!.env.example
!.env.sample
!.env.*.example
!.env.*.sample

# Build products and test output
.build/
/build/
/DerivedData/
deploy/*.app/
*.dSYM/
*.xcarchive/

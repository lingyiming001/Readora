Resources/iOS/Kokoro/*
!Resources/iOS/Kokoro/.gitkeep
# Prepared MeloTTS weights (recreated by scripts/prepare-melotts.py)
Resources/iOS/MeloTTS/*
!Resources/iOS/MeloTTS/.gitkeep
